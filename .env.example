# ==============================================================================
# 🎮 MINECRAFT DISCORD BOT AYAR DOSYASI (.env)
# ==============================================================================
# Bu dosya botunuzun beynidir! Tüm ayarları buradan yapacaksınız.
# ID değerlerini (sunucu id, kanal id vb.) Discord'da "Geliştirici Modu"nu
# açarak sağ tıklayıp "ID'yi Kopyala" diyerek alabilirsiniz.
# ==============================================================================

# ── BOT TEMEL AYARLARI ────────────────────────────────────────────────────────
# DISCORD_TOKEN: Discord Developer Portal'dan aldığınız bot token'ı. (GİZLİ TUTUN!)
DISCORD_TOKEN=

# CLIENT_ID: Botunuzun Application ID'si.
CLIENT_ID=

# GUILD_ID: Botun çalışacağı tek sunucunun ID'si (Sunucunuza sağ tıklayıp alın)
GUILD_ID=

# SERVER_NAME: Embed'lerde ve durumlarda gözükecek sunucu isminiz
SERVER_NAME=Minecraft Sunucusu

# EMBED_COLOR: Botun atacağı mesajların solundaki çizginin rengi (HEX kodu)
EMBED_COLOR="#D4AF37"

# WEBSITE_URL: Sunucunuzun web sitesi (Varsa). /sunucu komutunda görünür.
WEBSITE_URL=""

# ── MINECRAFT SUNUCU İZLEME ───────────────────────────────────────────────────
# MC_SERVER_IP: Minecraft sunucunuzun sayısal IP'si veya domain adresi (örn: play.sunucum.com)
MC_SERVER_IP=

# MC_SERVER_PORT: Genelde Java için 25565, Bedrock için 19132'dir.
MC_SERVER_PORT=25565

# MC_SERVER_TYPE: 'java' veya 'bedrock' yazın.
MC_SERVER_TYPE=java

# PING_INTERVAL_SECONDS: Sunucuya kaç saniyede bir ping atılacağı (60 saniye idealdir)
PING_INTERVAL_SECONDS=60

# STAT_CHANNEL_UPDATE_MINUTES: Ses kanallarındaki istatistiklerin kaç dakikada bir güncelleneceği (Discord sınırlarına takılmamak için 10'dan az yapmayın)
STAT_CHANNEL_UPDATE_MINUTES=10

# STATS_CHANNEL_PLAYERCOUNT_ID: (İsteğe Bağlı) İçinde aktif oyuncu sayısının yazacağı Ses Kanalı ID'si. İstemiyorsanız BOŞ bırakın.
STATS_CHANNEL_PLAYERCOUNT_ID=

# STATS_CHANNEL_RECORD_ID: (İsteğe Bağlı) İçinde rekor oyuncu sayısının yazacağı Ses Kanalı ID'si. İstemiyorsanız BOŞ bırakın.
STATS_CHANNEL_RECORD_ID=

# SERVER_OFFLINE_ALERT_CHANNEL_ID: Sunucu çöktüğünde/kapandığında bildirim gidecek metin kanalı ID'si
SERVER_OFFLINE_ALERT_CHANNEL_ID=

# SERVER_OFFLINE_ALERT_ROLE_ID: Sunucu çöktüğünde etiketlenecek rolün ID'si (örn: Kurucu veya Geliştirici rolü)
SERVER_OFFLINE_ALERT_ROLE_ID=


# ── LOBİ (KARŞILAMA VE AYRILMA) ───────────────────────────────────────────────
# LOBBY_CHANNEL_ID: Gelen ve giden oyuncuların resimli mesajla bildirileceği kanal ID'si
LOBBY_CHANNEL_ID=

# AUTO_ROLE_ID: Sunucuya yeni girenlere otomatik olarak (saniyesinde) verilecek rol ID'si
AUTO_ROLE_ID=


# ── ÖNERİ SİSTEMİ ─────────────────────────────────────────────────────────────
# SUGGESTIONS_CHANNEL_ID: Oyuncuların önerilerini yazacağı kanal ID'si
SUGGESTIONS_CHANNEL_ID=



# ── MODERASYON SİSTEMİ ────────────────────────────────────────────────────────
# MOD_LOG_CHANNEL_ID: Biri banlandığında, kicklendiğinde veya susturulduğunda log düşecek kanal ID'si
MOD_LOG_CHANNEL_ID=

# MOD_ROLE_IDS: Moderasyon komutlarını (/ban, /kick, /warn vb.) KULLANABİLECEK YETKİLİ rollerin ID'leri.
# Birden fazla rol eklemek için aralarına sadece VİRGÜL koyun (Boşluk bırakmayın!).
# Örnek: 123456789,987654321,1122334455
MOD_ROLE_IDS=

# WARN_LIMIT_MUTE: Birisi bu sayı kadar uyarı aldığında (örn: 3) otomatik olarak 1 gün susturulur (timeout). Kapalı tutmak için 0 yazın.
WARN_LIMIT_MUTE=3


# ── TICKET (DESTEK) SİSTEMİ ───────────────────────────────────────────────────
# TICKET_CATEGORY_ID: Yeni açılan ticket kanallarının hangi kategorinin içinde oluşacağı (Kategori ID)
TICKET_CATEGORY_ID=

# TICKET_PANEL_CHANNEL_ID: İnsanların ticket açmak için tıklayacağı butonun bulunduğu kanal ID'si
TICKET_PANEL_CHANNEL_ID=

# TICKET_LOG_CHANNEL_ID: Kapatılan ticket'ların geçmiş mesajlarının (transcript) yükleneceği yönetici kanalı
TICKET_LOG_CHANNEL_ID=

# TICKET_STAFF_ROLE_IDS: Ticketları devralacak, görecek ve cevaplayacak YETKİLİ rollerin ID'leri.
# Birden fazla yetkili rolü eklemek için aralarına virgül koyun!
# Örnek: 8888888,9999999
TICKET_STAFF_ROLE_IDS=


# ── YETKİLİ BAŞVURU SİSTEMİ ───────────────────────────────────────────────────
# STAFF_APP_CHANNEL_ID: İnsanların yaptığı başvuruların embed mesajı olarak düşeceği yetkili kanalı ID'si
STAFF_APP_CHANNEL_ID=

# (İsteğe Bağlı) Aşağıdaki soruları sunucunuzun konseptine göre dilediğiniz gibi değiştirebilirsiniz.
STAFF_APP_QUESTION_1="Adınız ve Yaşınız?"
STAFF_APP_QUESTION_2="Daha önceki tecrübeleriniz neler?"
STAFF_APP_QUESTION_3="Neden yetkili olmak istiyorsunuz?"
STAFF_APP_QUESTION_4="Günlük aktif olabileceğiniz saatler?"
STAFF_APP_QUESTION_5="Eklemek istediğiniz bir şey var mı? (İsteğe Bağlı)"
