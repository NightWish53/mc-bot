{
  "name": "minecraft-discord-bot",
  "version": "1.0.0",
  "description": "Tek sunucuya kurulan acik kaynak Minecraft topluluk botu",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx src/scripts/deployCommands.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.17.3",
    "minecraft-server-util": "^5.4.4",
    "satori": "^0.29.0",
    "satori-html": "^0.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}